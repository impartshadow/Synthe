{
  "hooks": {
    "PreToolUse": [{
      "matcher": "^(Bash|mcp__.*__(synthe_submit_approval|github_publish|push_files|create_or_update_file|delete_file|merge_pull_request|create_branch))$",
      "hooks": [{
        "type": "command",
        "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/pre_tool_use.py\"",
        "timeout": 5
      }]
    }]
  }
}
